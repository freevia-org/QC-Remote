{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "qc-remote-cloud",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-08",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"workers_dev": false,
	"routes": [
		{
			"pattern": "qcrc.freevia.org",
			"custom_domain": true
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "DEVICE_SESSION",
				"class_name": "DeviceSession"
			},
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"DeviceSession"
			]
		}
	],
	"vars": {
		"QCRC_ENVIRONMENT": "production"
	},
	// Per-client-address limits for the unauthenticated routes that write KV
	// (src/rate-limit.ts). Workers rate limiting needs no dashboard setup: the
	// namespace ids only have to be unique within the account. `period` may be
	// 10 or 60 seconds. Production refuses those routes if a binding is
	// missing; local dev without one proceeds unlimited.
	"ratelimits": [
		{
			// POST /v1/host/pairing-sessions, /pair/sign-in, /pair/cancel,
			// /v1/device/pair and /v1/device/pair/replace-v1,
			// each route counted separately per address.
			"name": "QCRC_PAIRING_RATE_LIMIT",
			"namespace_id": "41001",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			// GET /authorize and POST /register, counted separately per address.
			"name": "QCRC_OAUTH_RATE_LIMIT",
			"namespace_id": "41002",
			"simple": { "limit": 30, "period": 60 }
		}
	],
	"observability": {
		"enabled": true,
		"redact_query_string": true,
		"head_sampling_rate": 0.01
	},
	"version_metadata": {
		"binding": "QCRC_VERSION_METADATA"
	},
	// Both bindings point at the same KV namespace: QCRC_OAUTH is what this
	// Worker's own code uses, OAUTH_KV is the fixed name the OAuth provider
	// library expects. Neither id is committed here -- run
	// `npm run kv:configure` (reads QCRC_OAUTH_KV_NAMESPACE_ID from the shell
	// environment only; it refuses a .env file here, because Wrangler would
	// load that into the Worker's vars) to generate wrangler.local.jsonc with
	// the real id, then pass `-c wrangler.local.jsonc` to wrangler. See
	// README.md.
	"kv_namespaces": [
		{
			"binding": "QCRC_OAUTH",
			"id": "REPLACE_WITH_QCRC_OAUTH_KV_NAMESPACE_ID"
		},
		{
			"binding": "OAUTH_KV",
			"id": "REPLACE_WITH_QCRC_OAUTH_KV_NAMESPACE_ID"
		}
	]
}
