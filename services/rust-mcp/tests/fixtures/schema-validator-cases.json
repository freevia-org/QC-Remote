    {"name":"visible text accepts empty","schema":{"type":"string","pattern":"^[^\\x00-\\x1F\\x7F]*$"},"value":"","valid":true},
    {"name":"visible text refuses a unit separator","schema":{"type":"string","pattern":"^[^\\x00-\\x1F\\x7F]*$"},"value":"name\u001f","valid":false},
    {"name":"visible text refuses DEL","schema":{"type":"string","pattern":"^[^\\x00-\\x1F\\x7F]*$"},"value":"a\u007f","valid":false},
    {"name":"array within bounds","schema":{"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,"items":{"type":"integer","minimum":1,"maximum":3}},"value":[1,3],"valid":true},
    {"name":"array empty","schema":{"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,"items":{"type":"integer","minimum":1,"maximum":3}},"value":[],"valid":false},
    {"name":"array repeats","schema":{"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,"items":{"type":"integer","minimum":1,"maximum":3}},"value":[2,2],"valid":false},
    {"name":"array item out of range","schema":{"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,"items":{"type":"integer","minimum":1,"maximum":3}},"value":[0],"valid":false},
    {"name":"object with its required property","schema":{"type":"object","required":["a"],"additionalProperties":false,"properties":{"a":{"type":"integer","minimum":0,"maximum":9}}},"value":{"a":1},"valid":true},
    {"name":"object missing a required property","schema":{"type":"object","required":["a"],"additionalProperties":false,"properties":{"a":{"type":"integer","minimum":0,"maximum":9}}},"value":{},"valid":false},
    {"name":"object with an extra property","schema":{"type":"object","required":["a"],"additionalProperties":false,"properties":{"a":{"type":"integer","minimum":0,"maximum":9}}},"value":{"a":1,"b":2},"valid":false},
    {"name":"dependent rule satisfied by one anyOf branch","schema":{"type":"object","properties":{"port":{"type":"integer","minimum":1,"maximum":4},"impedance":{"type":["number","null"]}},"anyOf":[{"properties":{"port":{"const":4},"impedance":{"type":"null"}}},{"properties":{"port":{"enum":[1,2,3]}}}]},"value":{"port":4,"impedance":null},"valid":true},
    {"name":"dependent rule matched by no anyOf branch","schema":{"type":"object","properties":{"port":{"type":"integer","minimum":1,"maximum":4},"impedance":{"type":["number","null"]}},"anyOf":[{"properties":{"port":{"const":4},"impedance":{"type":"null"}}},{"properties":{"port":{"enum":[1,2,3]}}}]},"value":{"port":4,"impedance":0.5},"valid":false},
    {"name":"allOf applies every branch","schema":{"allOf":[{"type":"integer"},{"minimum":5}]},"value":4,"valid":false},
    {"name":"not excludes a matching value","schema":{"type":["integer","null"],"not":{"type":"null"}},"value":null,"valid":false},
    {"name":"not admits a non-matching value","schema":{"type":["integer","null"],"not":{"type":"null"}},"value":1,"valid":true},
    {"name":"an unknown keyword fails closed","schema":{"type":"string","format":"email"},"value":"a@b.c","valid":false},
    {"name":"an unknown keyword under not fails closed too","schema":{"not":{"format":"email"}},"value":"a@b.c","valid":false},
    {"name":"descriptions constrain nothing","schema":{"type":"string","description":"Copy presetIdentity.","title":"Identity"},"value":"x","valid":true}
  ]
