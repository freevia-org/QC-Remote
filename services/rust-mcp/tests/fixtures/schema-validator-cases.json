{
  "about": "Shared cases for the two action-input validators: services/rust-mcp/src/schema.rs (local MCP) and services/qc-remote-cloud/src/action-schema.ts (cloud connector). Both suites run every case and must reach the stated verdict, so a call one surface accepts is not refused by the other. Integral floats (3.0 against an integer schema) are deliberately absent: JSON.parse turns 3.0 into 3 before the Worker sees it, so no fixture can express that case to both; Rust refuses it and the Worker forwards 3.",
  "cases": [
    {"name":"integer accepts an integer","schema":{"type":"integer"},"value":3,"valid":true},
    {"name":"integer refuses a fraction","schema":{"type":"integer"},"value":3.5,"valid":false},
    {"name":"integer refuses numeric text","schema":{"type":"integer"},"value":"3","valid":false},
    {"name":"number accepts a fraction","schema":{"type":"number"},"value":0.25,"valid":true},
    {"name":"boolean refuses zero","schema":{"type":"boolean"},"value":0,"valid":false},
    {"name":"nullable integer accepts null","schema":{"type":["integer","null"]},"value":null,"valid":true},
    {"name":"nullable integer refuses the text null","schema":{"type":["integer","null"]},"value":"null","valid":false},
    {"name":"nullable string accepts the text null","schema":{"type":["string","null"]},"value":"null","valid":true},
    {"name":"minimum is inclusive","schema":{"type":"integer","minimum":40,"maximum":240},"value":40,"valid":true},
    {"name":"below minimum","schema":{"type":"integer","minimum":40,"maximum":240},"value":39,"valid":false},
    {"name":"above maximum","schema":{"type":"integer","minimum":40,"maximum":240},"value":241,"valid":false},
    {"name":"enum member","schema":{"enum":[0,2,4]},"value":2,"valid":true},
    {"name":"enum non-member","schema":{"enum":[0,2,4]},"value":3,"valid":false},
    {"name":"const match","schema":{"const":true},"value":true,"valid":true},
    {"name":"const mismatch","schema":{"const":true},"value":false,"valid":false},
    {"name":"lengths count code points, not UTF-16 units","schema":{"type":"string","minLength":2,"maxLength":2},"value":"\ud83c\udfb8\ud83c\udfb8","valid":true},
    {"name":"empty string refused by minLength 1","schema":{"type":"string","minLength":1},"value":"","valid":false},
    {"name":"too long","schema":{"type":"string","maxLength":3},"value":"abcd","valid":false},
    {"name":"colour accepts mixed case","schema":{"type":"string","pattern":"^#[0-9a-fA-F]{6}$"},"value":"#AbCdEf","valid":true},
    {"name":"colour refuses a non-hex digit","schema":{"type":"string","pattern":"^#[0-9a-fA-F]{6}$"},"value":"#abcdeg","valid":false},
    {"name":"colour refuses seven digits","schema":{"type":"string","pattern":"^#[0-9a-fA-F]{6}$"},"value":"#abcdef0","valid":false},
    {"name":"folder key accepts a path with a trailing slash","schema":{"type":"string","pattern":"^(?!\\s)(?!.*\\s$)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"},"value":"/media/My Presets/","valid":true},
    {"name":"folder key refuses a parent segment","schema":{"type":"string","pattern":"^(?!\\s)(?!.*\\s$)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"},"value":"/media/../Presets","valid":false},
    {"name":"folder key refuses a doubled slash","schema":{"type":"string","pattern":"^(?!\\s)(?!.*\\s$)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"},"value":"/media//Presets","valid":false},
    {"name":"folder key refuses a backslash","schema":{"type":"string","pattern":"^(?!\\s)(?!.*\\s$)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"},"value":"bad\\key","valid":false},
    {"name":"folder key refuses a line separator","schema":{"type":"string","pattern":"^(?!\\s)(?!.*\\s$)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"},"value":"a\u2028b","valid":false},
    {"name":"folder key refuses a newline","schema":{"type":"string","pattern":"^(?!\\s)(?!.*\\s$)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"},"value":"a\nb","valid":false},
    {"name":"segment accepts a name","schema":{"type":"string","pattern":"^(?!\\s)(?!.*\\s$)(?!\\.{1,2}$)[^/\\\\\\x00-\\x1F\\x7F]+$"},"value":"Preset A","valid":true},
    {"name":"segment refuses a slash","schema":{"type":"string","pattern":"^(?!\\s)(?!.*\\s$)(?!\\.{1,2}$)[^/\\\\\\x00-\\x1F\\x7F]+$"},"value":"a/b","valid":false},
    {"name":"segment refuses dot-dot","schema":{"type":"string","pattern":"^(?!\\s)(?!.*\\s$)(?!\\.{1,2}$)[^/\\\\\\x00-\\x1F\\x7F]+$"},"value":"..","valid":false},
    {"name":"segment refuses a trailing space","schema":{"type":"string","pattern":"^(?!\\s)(?!.*\\s$)(?!\\.{1,2}$)[^/\\\\\\x00-\\x1F\\x7F]+$"},"value":"trailing ","valid":false},
    {"name":"trimmed text accepts U+0085, which JavaScript does not call space","schema":{"type":"string","pattern":"^(?!\\s)(?!.*\\s$)[^\\x00-\\x1F\\x7F]+$"},"value":"\u0085","valid":true},
    {"name":"trimmed text refuses a leading byte-order mark","schema":{"type":"string","pattern":"^(?!\\s)(?!.*\\s$)[^\\x00-\\x1F\\x7F]+$"},"value":"\ufeffname","valid":false},
