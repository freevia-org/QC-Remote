    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:mac": "tauri icon src-tauri/icons/icon.png --output src-tauri/icons/generated && tauri build --config src-tauri/tauri.macos.conf.json --features desktop-broker,custom-protocol"
  },
  "dependencies": {
    "@qc-remote/client": "0.1.0",
    "@qc-remote/core": "0.1.0",
    "@qc-remote/form-factors": "0.1.0",
