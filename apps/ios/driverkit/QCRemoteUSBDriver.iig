#include <DriverKit/IOService.iig>
#include <DriverKit/IOUserClient.iig>
#include <DriverKit/OSData.iig>
#include <USBDriverKit/IOUSBHostDevice.iig>
#include <USBDriverKit/IOUSBHostInterface.iig>
#include <USBDriverKit/IOUSBHostPipe.iig>

struct QCRemoteUSBDriver_IVars {
    IOUSBHostDevice *device = nullptr;
    IOUSBHostInterface *hidInterface = nullptr;
    IOUSBHostPipe *inputPipe = nullptr;
    uint8_t interfaceNumber = 0;
    uint8_t inputEndpointAddress = 0;
    uint16_t inputPacketSize = 0;
    bool deviceOpened = false;
    bool interfaceOpened = false;
};

class QCRemoteUSBDriver : public IOService {
public:
    virtual kern_return_t Start(IOService *provider) override;
    virtual kern_return_t Stop(IOService *provider) override;
    virtual kern_return_t NewUserClient(uint32_t type, IOUserClient **userClient) override;

    kern_return_t ReadReport(OSData **report) LOCALONLY;
    kern_return_t WriteReport(OSData *report, uint32_t *bytesTransferred, kern_return_t *usbStatus) LOCALONLY;
    kern_return_t CopyDiagnostics(OSData **diagnostics) LOCALONLY;
    void ReleaseUsbResources() LOCALONLY;
};
