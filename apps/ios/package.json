{
  "name": "@qc-remote/ios",
  "version": "0.1.0",
  "license": "(MIT OR Apache-2.0) AND LicenseRef-QC-Remote-Reference",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "ios:add": "cap add ios --packagemanager SPM && node ./tools/normalize-spm-paths.mjs",
    "ios:sync": "npm run build && cap sync ios && node ./tools/normalize-spm-paths.mjs",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/status-bar": "^8.0.4",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@qc-remote/ios-native-bridge": "file:./native-bridge",
    "@qc-remote/client": "0.1.0",
    "@qc-remote/core": "0.1.0",
    "@qc-remote/form-factors": "0.1.0",
    "@qc-remote/theme": "0.1.0",
    "@qc-remote/ui": "0.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "esbuild": "0.28.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
